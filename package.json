{
  "name": "ai-visibility-readiness-audit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --no-deprecation ./node_modules/next/dist/bin/next dev",
    "build": "node --no-deprecation --max-old-space-size=8000 ./node_modules/next/dist/bin/next build",
    "start": "node --no-deprecation ./node_modules/next/dist/bin/next start -p 3003",
    "preview": "node --no-deprecation ./node_modules/next/dist/bin/next start -p 3003",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
